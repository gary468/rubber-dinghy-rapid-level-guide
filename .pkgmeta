package-as: RubberDinghyRapidLevelGuide

# Libraries are fetched by the packager at release time, never committed.
externals:
  Libs/LibStub:
    url: https://repos.curseforge.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0:
    url: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/HereBeDragons:
    url: https://github.com/Nevcairiel/HereBeDragons
    tag: latest
  Libs/LibDataBroker-1.1:
    url: https://github.com/tekkub/libdatabroker-1-1
  Libs/LibDBIcon-1.0:
    url: https://repos.curseforge.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0

ignore:
  - tools
  - SETUP.md
  - media/logo.png
  - media/duck.png
  - media/duck-400.png
